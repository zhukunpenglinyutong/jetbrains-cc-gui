    <version>1</version>
    <vendor>Development only</vendor>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.github.idea-claude-code-gui</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.claudecodegui.markdown.NativeMarkdownSmokeActivity"/>
    </extensions>
</idea-plugin>
