{
  "patterns": [
    {
      "code": "codexWriterConflict",
      "match": {
        "regex": "already has (?:an active|a live local) writer|already owned by another (?:chat )?window"
      },
      "solutions": [
        {
          "key": "releaseWriter",
          "recommended": true,
          "steps": [{ "kind": "instruction" }, { "kind": "instruction" }]
        }
      ]
    },
    {
      "code": "codexThreadClosing",
      "match": {
        "regex": "thread \\S+ is closing;\\s*retry thread/resume after the thread is closed"
      },
      "solutions": [
        {
          "key": "waitForClose",
          "recommended": true,
          "steps": [{ "kind": "instruction" }, { "kind": "instruction" }]
        }
      ]
    },
    {
      "code": "codexThreadHistoryMissing",
      "match": {
        "regex": "no rollout found for (?:thread|conversation) id"
      },
      "solutions": [
        {
          "key": "checkStorage",
          "recommended": true,
          "steps": [{ "kind": "instruction" }, { "kind": "instruction" }]
        },
        {
          "key": "startNewIfMissing",
          "recommended": false,
          "steps": [{ "kind": "instruction" }]
        }
      ]
    },
    {
      "code": "codexThreadArchived",
      "match": {
        "regex": "(?:session|thread) \\S+ is archived"
      },
      "solutions": [
        {
          "key": "unarchive",
          "recommended": true,
          "steps": [{ "kind": "instruction" }, { "kind": "instruction" }]
        }
      ]
    },
    {
      "code": "codexThreadResumeConfiguration",
      "match": {
        "regex": "required MCP servers failed to initialize|thread/resume[^\\r\\n]*(?:failed to load configuration|invalid config(?:uration)?|failed to parse config(?:uration)?)"
      },
      "solutions": [
        {
          "key": "repairConfiguration",
          "recommended": true,
          "steps": [{ "kind": "instruction" }, { "kind": "instruction" }]
        }
      ]
    },
    {
      "code": "codexThreadResume",
      "match": {
        "regex": "thread/resume"
      },
      "solutions": [
        {
          "key": "inspectCause",
          "recommended": true,
          "steps": [{ "kind": "instruction" }, { "kind": "instruction" }]
        },
        {
          "key": "checkCli",
          "recommended": false,
          "steps": [
            { "kind": "command", "command": "codex --version" },
            { "kind": "link", "url": "https://learn.chatgpt.com/docs/codex/cli#getting-started" }
          ]
        }
      ]
    },
    {
      "code": "sdkNativeBinaryMissing",
      "match": {
        "regex": "Native CLI binary for [^ ]+ not found",
        "keywordsAll": ["claude-agent-sdk"]
      },
      "solutions": [
        {
          "key": "switchRegistry",
          "recommended": true,
          "steps": [
            {
              "kind": "command",
              "command": "npm config set registry https://registry.npmjs.org/"
            },
            {
              "kind": "navigation",
              "action": "openDependencySettings"
            },
            {
              "kind": "command",
              "command": "npm config set registry https://registry.npmmirror.com/"
            }
          ]
        },
        {
          "key": "downgrade",
          "recommended": false,
          "steps": [
            {
              "kind": "navigation",
              "action": "openDependencySettings"
            }
          ]
        }
      ]
    },
    {
      "code": "claudeCodeVersionTooOld",
      "match": {
        "regex": "claude_code_version_too_old|Claude Code \\S+ does not support this model"
      },
      "solutions": [
        {
          "key": "updateSdk",
          "recommended": true,
          "steps": [
            {
              "kind": "action",
              "action": "updateClaudeSdk"
            }
          ]
        },
        {
          "key": "updateCustomCli",
          "recommended": false,
          "steps": [
            {
              "kind": "command",
              "command": "claude update"
            }
          ]
        }
      ]
    },
    {
      "code": "spawnEbusy",
      "match": {
        "regex": "spawn EBUSY"
      },
      "solutions": [
        {
          "key": "checkNodeVersion",
          "recommended": true,
          "steps": [
            {
              "kind": "command",
              "command": "node -v"
            }
          ]
        },
        {
          "key": "reinstallLatestSdk",
          "recommended": false,
          "steps": [
            {
              "kind": "command",
              "command": "npm config set registry https://registry.npmjs.org/"
            },
            {
              "kind": "navigation",
              "action": "openDependencySettings"
            }
          ]
        }
      ]
    },
    {
      "code": "codexCliUnavailable",
      "match": {
        "regex": "codex app-server exited \\(code=",
        "keywordsAll": ["Codex CLI check"]
      },
      "solutions": [
        {
          "key": "reinstallCodexCli",
          "recommended": true,
          "steps": [
            {
              "kind": "link",
              "url": "https://learn.chatgpt.com/docs/codex/cli#getting-started"
            },
            {
              "kind": "command",
              "command": "codex --version"
            }
          ]
        },
        {
          "key": "pointCodexBin",
          "recommended": false,
          "steps": [
            {
              "kind": "command",
              "command": "which -a codex"
            }
          ]
        }
      ]
    }
  ]
}
